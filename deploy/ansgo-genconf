#!/bin/bash
# =============================================================================
# ansgo-genconf —— 从 config.json(端口) + proxy-secrets.env(密钥) 重新生成服务配置
#
# 单一事实来源：
#   /etc/ansgo/panel.json   -> 端口 + 面板设置 + 域名 (JSON, 由面板/管理员维护)
#   /etc/ansgo/secrets.env      -> SS_KEY / ANYTLS_* / NAIVE_* (shell 可 source)
#   /etc/ssl/ansgo/*.pem        -> 共享真实证书
#
# 用法:
#   ansgo-genconf sing-box          # 重新生成 /etc/sing-box/config.json
#   ansgo-genconf caddy             # 重新生成 /etc/caddy/Caddyfile
#   ansgo-genconf all               # 两者都生成
#   ansgo-genconf validate          # 仅校验语法（sing-box check + caddy validate）
#
# 被 ansgo-admin(regen) 和 ansgo-panel(端口/密钥变更) 通过 exec 调用。
# =============================================================================
set -euo pipefail
CONF="/etc/ansgo/panel.json"
SECRETS="/etc/ansgo/secrets.env"
CERTDIR="${BV_CERTDIR:-/etc/ssl/ansgo}"

# --- 加载密钥 ---
if [ -f "$SECRETS" ]; then
  # shellcheck disable=SC1090
  set -a; source "$SECRETS"; set +a
fi

# --- 读端口（JSON，python3 解析；缺省回退）---
get_conf() { python3 -c "import json,sys; d=json.load(open('$CONF')); print(d.get('$1',''))" 2>/dev/null || true; }
DOMAIN=$(get_conf domain);        DOMAIN="${DOMAIN:-example.com}"
SS_PORT=$(get_conf ss_port);      SS_PORT="${SS_PORT:-23456}"
ANYTLS_PORT=$(get_conf anytls_port); ANYTLS_PORT="${ANYTLS_PORT:-8443}"
NAIVE_PORT=$(get_conf naive_port); NAIVE_PORT="${NAIVE_PORT:-443}"
SS_METHOD="${SS_METHOD:-2022-blake3-aes-128-gcm}"
# 伪装站点（两个独立）：
#   disguise_panel -> :443 纯反代伪装站（浏览器直访命中，无代理），默认 example.com
#   disguise_naive -> :NAIVE_PORT NaiveProxy inbound 的伪装站（未认证命中），默认 example.com
# 格式：proxy:<URL>（反代）或 page（/var/www/html 默认页）
DISGUISE_PANEL=$(get_conf disguise_panel); DISGUISE_PANEL="${DISGUISE_PANEL:-proxy:https://example.com}"
DISGUISE_NAIVE=$(get_conf disguise_naive); DISGUISE_NAIVE="${DISGUISE_NAIVE:-proxy:https://example.com}"
# 向后兼容：旧 disguise 字段存在时回填 disguise_naive
DISGUISE_LEGACY=$(get_conf disguise); [ -n "$DISGUISE_LEGACY" ] && [ "$DISGUISE_NAIVE" = "proxy:https://example.com" ] && DISGUISE_NAIVE="$DISGUISE_LEGACY"

# 校验必备密钥
need() { [ -n "${!1:-}" ] || { echo "ansgo-genconf: 缺少 $1（检查 $SECRETS）" >&2; exit 2; }; }
need SS_KEY; need ANYTLS_PASS; need ANYTLS_UUID; need NAIVE_USER; need NAIVE_PASS

gen_singbox() {
  cat > /etc/sing-box/config.json <<EOF
{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "shadowsocks",
      "tag": "ss-in",
      "listen": "::",
      "listen_port": ${SS_PORT},
      "method": "${SS_METHOD}",
      "password": "${SS_KEY}"
    },
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": ${ANYTLS_PORT},
      "users": [
        { "name": "${ANYTLS_UUID}", "password": "${ANYTLS_PASS}" }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${DOMAIN}",
        "certificate_path": "${CERTDIR}/fullchain.pem",
        "key_path": "${CERTDIR}/privkey.pem"
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" }
  ]
}
EOF
  echo "已生成 /etc/sing-box/config.json (ss=${SS_PORT}, anytls=${ANYTLS_PORT}, sni=${DOMAIN})"
}

# 根据伪装配置生成 caddy 块（反代 or 默认页）
# 参数 $1 = DISGUISE 值（proxy:<URL> 或 page）
disguise_block() {
  case "$1" in
    proxy:*)
      local up; up="${1#proxy:}"
      local host; host="$(echo "$up" | sed -E 's#^https?://([^/:]+).*#\1#')"
      cat <<BLK
  reverse_proxy ${up} {
    header_up Host ${host}
  }
BLK
      ;;
    page|file|file_server)
      cat <<BLK
  file_server {
    root /var/www/html
  }
BLK
      ;;
    *)
      cat <<BLK
  file_server {
    root /var/www/html
  }
BLK
      ;;
  esac
}

gen_caddy() {
  local PANEL_BLK NAIVE_BLK
  PANEL_BLK="$(disguise_block "$DISGUISE_PANEL")"
  NAIVE_BLK="$(disguise_block "$DISGUISE_NAIVE")"
  cat > /etc/caddy/Caddyfile <<EOF
{
  order forward_proxy before reverse_proxy
  order forward_proxy before file_server
  admin off
  log {
    level error
  }
}

# :443 纯反代伪装站（浏览器直访命中，不提供代理）
:443 {
  tls ${CERTDIR}/fullchain.pem ${CERTDIR}/privkey.pem
  encode zstd gzip
${PANEL_BLK}
}

# :${NAIVE_PORT} NaiveProxy（forward_proxy 认证走代理，未认证走伪装）
:${NAIVE_PORT} {
  tls ${CERTDIR}/fullchain.pem ${CERTDIR}/privkey.pem
  encode zstd gzip
  forward_proxy {
    basic_auth ${NAIVE_USER} ${NAIVE_PASS}
    hide_ip
    hide_via
    probe_resistance
  }
${NAIVE_BLK}
}

:80 {
  redir https://${DOMAIN}{uri} permanent
}
EOF
  echo "已生成 /etc/caddy/Caddyfile (:443 纯伪装=${DISGUISE_PANEL}, :${NAIVE_PORT} naive伪装=${DISGUISE_NAIVE}, :80->https 跳转)"
}

do_validate() {
  echo "=== sing-box check ==="
  /usr/local/bin/sing-box check -c /etc/sing-box/config.json && echo "sing-box config OK"
  echo "=== caddy validate ==="
  /usr/local/bin/caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
}

case "${1:-all}" in
  sing-box) gen_singbox ;;
  caddy)    gen_caddy ;;
  all)      gen_singbox; gen_caddy ;;
  validate) do_validate ;;
  *) echo "用法: ansgo-genconf {sing-box|caddy|all|validate}" >&2; exit 1 ;;
esac
