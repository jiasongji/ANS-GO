#!/bin/bash
# =============================================================================
# ansgo-genconf —— 从 panel.json + secrets.env 重新生成服务配置
#
# 单一事实来源：
#   /etc/ansgo/panel.json    端口 + 面板设置 + 域名 + 第2组服务 + 落地配置 (JSON)
#   /etc/ansgo/secrets.env   SS_KEY / ANYTLS_* / SOCKS_* / NAIVE_* / 第2组密钥 (shell 可 source)
#   /etc/ssl/ansgo/*.pem     共享真实证书
#
# 用法:
#   ansgo-genconf sing-box    # 重新生成 /etc/sing-box/config.json
#   ansgo-genconf caddy       # 重新生成 /etc/caddy/Caddyfile
#   ansgo-genconf all         # 两者都生成
#   ansgo-genconf validate    # 仅校验语法
#
# 核心逻辑用 python3（避免 bash heredoc 拼复杂 JSON 出错）。
# =============================================================================
set -euo pipefail
CONF="/etc/ansgo/panel.json"
SECRETS="/etc/ansgo/secrets.env"
CERTDIR="${BV_CERTDIR:-/etc/ssl/ansgo}"

# 加载密钥到环境（尽力加载；python 段会直接读文件做权威解析，
# 故此处 source 失败不致命——如某个值含空格未加引号时 source 会报错，
# 但 python 的逐行 partition 解析不受影响）。v1.5.23: 加 || true 避免 set -e 退出。
if [ -f "$SECRETS" ]; then set -a; source "$SECRETS" 2>/dev/null || true; set +a; fi

case "${1:-all}" in
  sing-box|caddy|all|validate) ;;
  *) echo "用法: ansgo-genconf {sing-box|caddy|all|validate}" >&2; exit 1 ;;
esac

python3 - "$@" <<'PYEOF'
import json, os, sys, subprocess

CONF = "/etc/ansgo/panel.json"
CERTDIR = os.environ.get("BV_CERTDIR", "/etc/ssl/ansgo")
SECRETS = "/etc/ansgo/secrets.env"
mode = sys.argv[1] if len(sys.argv) > 1 else "all"

# 证书路径：manual 模式读 panel.json 的 cert_fullchain/cert_privkey，否则回退 CERTDIR
# （此块在下方读 panel.json 之后才完成解析，这里只声明默认值兜底）

# ---- 读取配置 ----
with open(CONF) as f:
    cfg = json.load(f)

def g(k, d=""):
    return cfg.get(k, d)

DOMAIN = g("domain", "example.com")
PANEL_PORT = int(g("panel_port", 15608))
SS_PORT = int(g("ss_port", 23456))
ANYTLS_PORT = int(g("anytls_port", 8443))
SOCKS_PORT = int(g("socks_port", 10808))
NAIVE_PORT = int(g("naive_port", 44333))
SS_METHOD = os.environ.get("SS_METHOD", "2022-blake3-aes-128-gcm")

# v1.5.26: 多落地服务（替代旧的 group2_enabled/anytls2_port/ss_landing_* 扁平字段）。
#   panel.json 的 landings 数组，每项 = 一个 anytls 入站 + 可选一个远端出站（SS/SOCKS5）。
#   旧的 group2 单落地服务由 upgrade.sh 迁移为 landings[0]。
LANDINGS = g("landings", []) or []

# 伪装站点
DISGUISE_PANEL = g("disguise_panel", "proxy:https://example.com")
DISGUISE_NAIVE = g("disguise_naive", "proxy:https://example.com")

# 证书来源：cert_mode="manual" 且两路径齐全 -> 用绝对路径；否则回退 cert_dir/fullchain.pem+privkey.pem
# （与 Go 端 certPaths() 语义保持一致，全项目统一）
if g("cert_mode", "acme") == "manual" and g("cert_fullchain") and g("cert_privkey"):
    FULLCHAIN = g("cert_fullchain")
    PRIVKEY = g("cert_privkey")
else:
    FULLCHAIN = f"{CERTDIR}/fullchain.pem"
    PRIVKEY = f"{CERTDIR}/privkey.pem"

# 服务开关（面板内按需安装；无字段时默认 true 兼容旧部署）
def is_on(k):
    return str(g(k, "true")).lower() == "true"
SVC_SS = is_on("svc_ss_enabled")
SVC_ANYTLS = is_on("svc_anytls_enabled")
SVC_SOCKS = str(g("svc_socks_enabled", "false")).lower() == "true"
SVC_NAIVE = is_on("svc_naive_enabled")
# caddy_enable：是否部署 :443 伪装站 + :80 跳转。
#   true（默认，兼容旧部署）：caddy 监听 80/443，提供域名直访伪装
#   false（--no-caddy 模式，v1.5.6+）：跳过 80/443 站点块，让现有 nginx 等 web 服务器接管；
#             naive 站点仍生成（只听 naive 端口，不碰 80/443）
CADDY_ENABLE = is_on("caddy_enable")

# ---- 读取密钥 ----
secrets = {}
if os.path.exists(SECRETS):
    with open(SECRETS) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            secrets[k.strip()] = v.strip().strip('"')

def sec(k):
    v = secrets.get(k, "")
    if not v:
        print(f"ansgo-genconf: 缺少 {k}（检查 {SECRETS}）", file=sys.stderr)
        sys.exit(2)
    return v

SS_KEY = sec("SS_KEY")
ANYTLS_PASS = sec("ANYTLS_PASS")
ANYTLS_UUID = sec("ANYTLS_UUID")
SOCKS_USER = secrets.get("SOCKS_USER", "")
SOCKS_PASS = secrets.get("SOCKS_PASS", "")
if SVC_SOCKS and (not SOCKS_USER or not SOCKS_PASS):
    print("ansgo-genconf: SOCKS5 启用但缺少 SOCKS_USER/SOCKS_PASS（执行 ansgo-admin regen socks 生成）", file=sys.stderr)
    sys.exit(2)
NAIVE_USER = sec("NAIVE_USER")
NAIVE_PASS = sec("NAIVE_PASS")

# v1.5.26: 多落地服务 anytls 凭证（启用时必需）。
#   凭证存为 LANDING_<id>_PASS / LANDING_<id>_UUID（由 ansgo-admin regen-landing <id> 生成）。
#   缺凭证则在下方生成 inbound 时报错退出（同旧 anytls2 逻辑）。
def landing_secret(id, key_suffix):
    return secrets.get(f"LANDING_{id}_{key_suffix}", "")

# ===================== 生成 sing-box config =====================
# v1.5.14: 端口冲突预检测。
# v1.5.29: 扩展为全局本机监听端口检测。caddy / sing-box / 面板虽是独立进程，
#   但在裸金属与 Docker host 网络下处于同一网络命名空间，跨进程同端口同样会
#   bind: address already in use。genconf 在生成前必须显式拒绝。
def check_port_conflicts():
    ports = {}
    def add(port, name):
        try:
            port = int(port)
        except (ValueError, TypeError):
            return
        if port > 0:
            ports.setdefault(port, []).append(name)

    add(PANEL_PORT, "panel")
    if CADDY_ENABLE:
        add(443, ":443 伪装站")
        add(80, ":80 跳转")
    if SVC_NAIVE:
        add(NAIVE_PORT, "naive(caddy)")
    if SVC_SS:
        add(SS_PORT, "ss(sing-box)")
    if SVC_ANYTLS:
        add(ANYTLS_PORT, "anytls(sing-box)")
    if SVC_SOCKS:
        add(SOCKS_PORT, "socks(sing-box)")
    # v1.5.26: 多落地服务端口（每个启用落地的 anytls 端口）
    for L in LANDINGS:
        if str(L.get("enabled", "false")).lower() in ("true", "1") and L.get("port"):
            lname = L.get("name", L.get("id", "?"))
            add(L.get("port"), f"landing-{L.get('id','?')}({lname})(sing-box)")

    errors = []
    for port, names in ports.items():
        if len(names) > 1:
            errors.append(f"端口 {port} 被 {'+'.join(names)} 同时占用（同一主机网络命名空间内不能重复监听）")
    if errors:
        print("ansgo-genconf: 检测到端口冲突，拒绝生成配置：", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        print("请在面板修改冲突端口后重试（不同服务必须使用不同端口）。", file=sys.stderr)
        sys.exit(3)

def write_singbox_config(config):
    # v1.5.28 防御：写新 config 前备份旧文件，写完用 sing-box check 预检；
    # 校验失败则回滚旧配置并退出，避免把坏配置喂给 systemd 后 sing-box 进入 activating/restart loop。
    os.makedirs("/etc/sing-box", exist_ok=True)
    cfg_path = "/etc/sing-box/config.json"
    backup = None
    if os.path.exists(cfg_path):
        try:
            backup = open(cfg_path).read()
        except Exception:
            backup = None
    with open(cfg_path, "w") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)
    sb_bin = "/usr/local/bin/sing-box"
    if os.path.exists(sb_bin):
        try:
            r = subprocess.run([sb_bin, "check", "-c", cfg_path], capture_output=True, text=True, timeout=30)
            ok = (r.returncode == 0)
            err_out = (r.stderr or r.stdout or "").strip()
        except Exception as e:
            ok = False
            err_out = str(e)
        if not ok:
            if backup is not None:
                with open(cfg_path, "w") as f:
                    f.write(backup)
            else:
                try:
                    os.remove(cfg_path)
                except FileNotFoundError:
                    pass
            err_tail = err_out.splitlines()
            err_tail = err_tail[-1] if err_tail else "未知错误"
            print("ansgo-genconf: ❌ sing-box config 校验失败，已回滚旧配置（不会重启 sing-box）：", file=sys.stderr)
            print(f"  {err_tail}", file=sys.stderr)
            print("  常见原因：落地服务远端 SS 密钥长度/协议字段错误，或 AnyTLS/出站配置不被当前 sing-box 支持。", file=sys.stderr)
            sys.exit(4)


def gen_singbox():
    inbounds = []
    # SS inbound（按开关）
    if SVC_SS:
        inbounds.append({
            "type": "shadowsocks", "tag": "ss-in",
            "listen": "::", "listen_port": SS_PORT,
            "method": SS_METHOD, "password": SS_KEY,
        })
    # AnyTLS inbound（按开关）
    if SVC_ANYTLS:
        inbounds.append({
            "type": "anytls", "tag": "anytls-in",
            "listen": "::", "listen_port": ANYTLS_PORT,
            "users": [{"name": ANYTLS_UUID, "password": ANYTLS_PASS}],
            "tls": {
                "enabled": True, "server_name": DOMAIN,
                "certificate_path": FULLCHAIN,
                "key_path": PRIVKEY,
            },
        })

    # SOCKS5 inbound（按开关，强制用户名/密码鉴权）
    if SVC_SOCKS:
        inbounds.append({
            "type": "socks", "tag": "socks-in",
            "listen": "::", "listen_port": SOCKS_PORT,
            "users": [{"username": SOCKS_USER, "password": SOCKS_PASS}],
        })

    # v1.5.26: 多落地服务 inbound + outbound + route 规则。
    #   遍历 landings 数组，每个启用的落地服务：
    #     - 1 个 anytls inbound:  tag = "landing-in-<id>"
    #     - 若 remote_enabled: 1 个 outbound: tag = "landing-out-<id>"（shadowsocks 或 socks）
    #     - 1 条 route 规则:     inbound=[landing-in-<id>] -> outbound=landing-out-<id>
    #       （remote_enabled=false 时不加 outbound/rule，该落地走 sing-box 默认 direct）
    outbounds = [{"type": "direct", "tag": "direct"}]
    rules = []
    for L in LANDINGS:
        if str(L.get("enabled", "false")).lower() not in ("true", "1"):
            continue
        try:
            lport = int(L.get("port", 0))
        except (ValueError, TypeError):
            lport = 0
        if not lport:
            continue
        lid = str(L.get("id", ""))
        if not lid:
            print("ansgo-genconf: 落地服务缺少 id 字段，跳过", file=sys.stderr)
            continue
        lp = landing_secret(lid, "PASS")
        lu = landing_secret(lid, "UUID")
        if not lp or not lu:
            print(f"ansgo-genconf: 落地服务 #{lid} 启用但缺少 LANDING_{lid}_PASS/UUID"
                  f"（执行 ansgo-admin regen-landing {lid} 生成）", file=sys.stderr)
            sys.exit(2)
        in_tag = f"landing-in-{lid}"
        out_tag = f"landing-out-{lid}"
        inbounds.append({
            "type": "anytls", "tag": in_tag,
            "listen": "::", "listen_port": lport,
            "users": [{"name": lu, "password": lp}],
            "tls": {
                "enabled": True, "server_name": DOMAIN,
                "certificate_path": FULLCHAIN,
                "key_path": PRIVKEY,
            },
        })
        # 远端出口（仅 remote_enabled 且配置完整时生成）
        r_en = str(L.get("remote_enabled", "false")).lower() in ("true", "1")
        rtype = L.get("remote_type", "ss") or "ss"
        rhost = L.get("remote_host", "")
        try:
            rport = int(L.get("remote_port", 0) or 0)
        except (ValueError, TypeError):
            rport = 0
        if r_en and rhost and rport:
            rmethod = L.get("remote_method", "2022-blake3-aes-128-gcm") or "2022-blake3-aes-128-gcm"
            rpass = L.get("remote_password", "")
            if rtype == "socks":
                outbounds.append({
                    "type": "socks", "tag": out_tag,
                    "server": rhost, "server_port": rport,
                    "username": L.get("remote_user", ""),
                    "password": rpass,
                })
            else:  # ss（默认）
                outbounds.append({
                    "type": "shadowsocks", "tag": out_tag,
                    "server": rhost, "server_port": rport,
                    "method": rmethod, "password": rpass,
                })
            rules.append({"inbound": [in_tag], "outbound": out_tag})
        # remote_enabled=false -> 该落地走 direct（不加 outbound/rule，sing-box 默认 direct）

    config = {
        "log": {"level": "warn", "timestamp": True},
        "inbounds": inbounds,
        "outbounds": outbounds,
    }
    if rules:
        config["route"] = {"rules": rules}

    # 无任何 inbound 时写一个占位配置（避免 sing-box 启动失败），
    # 但调用方应判断是否需要启动 sing-box
    if not inbounds:
        write_singbox_config({"log": {"level": "warn"}, "inbounds": [], "outbounds": outbounds})
        print("已生成 /etc/sing-box/config.json (无启用 inbound，占位；sing-box 可不启动)")
        return

    write_singbox_config(config)
    note = f"ss={SS_PORT}, anytls={ANYTLS_PORT}"
    if SVC_SOCKS:
        note += f", socks={SOCKS_PORT}"
    # v1.5.26: 列出每个落地服务的端口 + 出口方式
    for L in LANDINGS:
        if str(L.get("enabled", "false")).lower() not in ("true", "1"):
            continue
        lname = L.get("name", L.get("id", "?"))
        try:
            lport = int(L.get("port", 0))
        except (ValueError, TypeError):
            continue
        via = "direct"
        if str(L.get("remote_enabled", "false")).lower() in ("true", "1"):
            rtype = L.get("remote_type", "ss")
            rhost = L.get("remote_host", "")
            via = f"->{rtype}-landing({rhost})"
        note += f", landing[{lname}]={lport}{via}"

    print(f"已生成 /etc/sing-box/config.json ({note}, sni={DOMAIN})")

# ===================== 生成 Caddyfile =====================
def disguise_block(val):
    """返回 caddy site block 内的伪装指令（缩进 2 空格的文本）"""
    if val.startswith("proxy:"):
        up = val[len("proxy:"):]
        import re
        m = re.match(r'^https?://([^/:]+)', up)
        host = m.group(1) if m else ""
        return f"  reverse_proxy {up} {{\n    header_up Host {host}\n  }}\n"
    else:  # page / file / file_server / 其它
        return "  file_server {\n    root /var/www/html\n  }\n"

def gen_caddy():
    blocks = []
    # global block：caddy_enable=false 时加 auto_https off
    #   （v1.5.10 修复：caddy 默认 auto_https on 会隐式监听 :80 做 ACME 挑战，
    #    --no-caddy 模式下 nginx 占着 80 → bind 失败；关掉 auto_https 避免冲突）
    # v1.5.25：移除 order forward_proxy before ... 指令——它们对同站点块内
    #   forward_proxy + reverse_proxy 共存时无效（caddy 默认排序仍把 forward_proxy
    #   放最后），改用 route {} 块强制显式顺序（见下方 naive 站点）。
    if CADDY_ENABLE:
        blocks.append("{\n  admin off\n  log {\n    level error\n  }\n}\n")
    else:
        blocks.append("{\n  admin off\n  auto_https off\n  log {\n    level error\n  }\n}\n")

    # :443 纯反代伪装站（caddy_enable=true 时生成；--no-caddy 模式跳过让 nginx 接管）
    if CADDY_ENABLE:
        blocks.append(f"# :443 纯反代伪装站（浏览器直访命中，不提供代理）\n:443 {{\n  tls {FULLCHAIN} {PRIVKEY}\n  encode zstd gzip\n{disguise_block(DISGUISE_PANEL)}}}\n")

    # :naive_port NaiveProxy + 伪装（按开关；caddy_enable 无关——naive 站点独立于 80/443）
    # v1.5.25 关键修复：用 route {} 块包裹，强制 forward_proxy 在 reverse_proxy/file_server
    #   之前执行。旧版用全局 order 指令，但 caddy 对同站点块内 forward_proxy+reverse_proxy
    #   共存时的排序有坑——默认把 forward_proxy 放最后 → CONNECT 请求被 reverse_proxy
    #   （伪装）拦截，forward_proxy 永远拿不到代理流量 → NaiveProxy 客户端「检测正常、
    #   反代正常、但代理不能用」。route {} 块按书写顺序执行，forward_proxy 写在最前即生效。
    #   官方 naiveproxy 示例用 file_server 不受此影响（file_server 排序天然在 forward_proxy 后），
    #   我们用 reverse_proxy 做伪装才踩了这个坑。
    if SVC_NAIVE:
        # disguise 内容缩进适配 route 块（多缩进 2 空格）
        naive_disguise = disguise_block(DISGUISE_NAIVE).replace("\n", "\n    ").rstrip()
        blocks.append(
            f"# :{NAIVE_PORT} NaiveProxy（forward_proxy 认证走代理，未认证走伪装）\n"
            f":{NAIVE_PORT} {{\n"
            f"  tls {FULLCHAIN} {PRIVKEY}\n"
            f"  route {{\n"
            f"    forward_proxy {{\n"
            f"      basic_auth {NAIVE_USER} {NAIVE_PASS}\n"
            f"      hide_ip\n"
            f"      hide_via\n"
            f"      probe_resistance\n"
            f"    }}\n"
            f"    {naive_disguise}\n"
            f"  }}\n"
            f"}}\n"
        )


    # :80 重定向（caddy_enable=true 时生成；--no-caddy 模式跳过）
    if CADDY_ENABLE:
        blocks.append(f":80 {{\n  redir https://{DOMAIN}{{uri}} permanent\n}}\n")

    os.makedirs("/etc/caddy", exist_ok=True)
    # v1.5.23 防御：写新 Caddyfile 前备份旧文件，写完用 caddy validate 预检；
    # 校验失败（如 naive 密码含空格/{} 破坏语法）则回滚旧文件并报错退出，
    # 避免把坏配置喂给 caddy 导致「重启后无法运行」（用户表现为 Naive 装上就挂）。
    CADDYFILE = "/etc/caddy/Caddyfile"
    backup = None
    if os.path.exists(CADDYFILE):
        try:
            backup = open(CADDYFILE).read()
        except Exception:
            backup = None
    new_content = "\n".join(blocks)
    with open(CADDYFILE, "w") as f:
        f.write(new_content)
    # 预检：仅当 caddy 二进制存在时才校验（裸金属首次安装可能还没装 caddy）
    caddy_bin = "/usr/local/bin/caddy"
    if os.path.exists(caddy_bin):
        try:
            r = subprocess.run([caddy_bin, "validate", "--config", CADDYFILE, "--adapter", "caddyfile"],
                               capture_output=True, text=True, timeout=30)
            ok = (r.returncode == 0)
            err_out = (r.stderr or r.stdout or "").strip()
        except Exception as e:
            ok = False
            err_out = str(e)
        if not ok:
            # 回滚旧配置，绝不把坏配置留下（caddy 重启会失败）
            if backup is not None:
                with open(CADDYFILE, "w") as f:
                    f.write(backup)
            err_tail = err_out.splitlines()
            err_tail = err_tail[-1] if err_tail else "未知错误"
            print(f"ansgo-genconf: ❌ Caddyfile 校验失败，已回滚旧配置（不会重启 caddy）：", file=sys.stderr)
            print(f"  {err_tail}", file=sys.stderr)
            print(f"  常见原因：NaiveProxy 用户名/密码含空格或 {{}} 等特殊字符。", file=sys.stderr)
            print(f"  请在面板「服务管理」页改用不含空白的凭证后重试。", file=sys.stderr)
            sys.exit(4)
    note = f":443 纯伪装={DISGUISE_PANEL}" if CADDY_ENABLE else "caddy_enable=false（跳过 80/443，nginx 等接管）"
    if SVC_NAIVE:
        note += f", :{NAIVE_PORT} naive伪装={DISGUISE_NAIVE}"
    suffix = ", :80->https 跳转" if CADDY_ENABLE else ""
    print(f"已生成 /etc/caddy/Caddyfile ({note}{suffix})")

# ===================== 校验 =====================
def do_validate():
    print("=== sing-box check ===")
    r = subprocess.run(["/usr/local/bin/sing-box", "check", "-c", "/etc/sing-box/config.json"])
    if r.returncode == 0:
        print("sing-box config OK")
    print("=== caddy validate ===")
    subprocess.run(["/usr/local/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"])

