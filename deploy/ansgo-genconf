#!/bin/bash
# =============================================================================
# ansgo-genconf —— 从 panel.json + secrets.env 重新生成服务配置
#
# 单一事实来源：
#   /etc/ansgo/panel.json    端口 + 面板设置 + 域名 + 第2组服务 + 落地配置 (JSON)
#   /etc/ansgo/secrets.env   SS_KEY / ANYTLS_* / NAIVE_* / 第2组密钥 (shell 可 source)
#   /etc/ssl/ansgo/*.pem     共享真实证书
#
# 用法:
#   ansgo-genconf sing-box    # 重新生成 /etc/sing-box/config.json
#   ansgo-genconf caddy       # 重新生成 /etc/caddy/Caddyfile
#   ansgo-genconf all         # 两者都生成
#   ansgo-genconf validate    # 仅校验语法
#
# 核心逻辑用 python3（避免 bash heredoc 拼复杂 JSON 出错）。
# =============================================================================
set -euo pipefail
CONF="/etc/ansgo/panel.json"
SECRETS="/etc/ansgo/secrets.env"
CERTDIR="${BV_CERTDIR:-/etc/ssl/ansgo}"

# 加载密钥到环境，供 python 读取
if [ -f "$SECRETS" ]; then set -a; source "$SECRETS"; set +a; fi

case "${1:-all}" in
  sing-box|caddy|all|validate) ;;
  *) echo "用法: ansgo-genconf {sing-box|caddy|all|validate}" >&2; exit 1 ;;
esac

python3 - "$@" <<'PYEOF'
import json, os, sys

CONF = "/etc/ansgo/panel.json"
CERTDIR = os.environ.get("BV_CERTDIR", "/etc/ssl/ansgo")
SECRETS = "/etc/ansgo/secrets.env"
mode = sys.argv[1] if len(sys.argv) > 1 else "all"

# 证书路径：manual 模式读 panel.json 的 cert_fullchain/cert_privkey，否则回退 CERTDIR
# （此块在下方读 panel.json 之后才完成解析，这里只声明默认值兜底）

# ---- 读取配置 ----
with open(CONF) as f:
    cfg = json.load(f)

def g(k, d=""):
    return cfg.get(k, d)

DOMAIN = g("domain", "example.com")
SS_PORT = int(g("ss_port", 23456))
ANYTLS_PORT = int(g("anytls_port", 8443))
NAIVE_PORT = int(g("naive_port", 44333))
SS_METHOD = os.environ.get("SS_METHOD", "2022-blake3-aes-128-gcm")

# 第2组服务（额外 anytls-2 / naive-2，可选走 ss 落地）
GROUP2_ENABLED = str(g("group2_enabled", "false")).lower() == "true"
ANYTLS2_PORT = int(g("anytls2_port", 0)) if g("anytls2_port") else 0
NAIVE2_PORT = int(g("naive2_port", 0)) if g("naive2_port") else 0

# 落地 SS 出口配置（第2组流量走这里）
LANDING_ENABLED = str(g("ss_landing_enabled", "false")).lower() == "true"
LANDING_HOST = g("ss_landing_host", "")
LANDING_PORT = int(g("ss_landing_port", 0)) if g("ss_landing_port") else 0
LANDING_METHOD = g("ss_landing_method", "2022-blake3-aes-128-gcm")
LANDING_PASS = g("ss_landing_password", "")

# 伪装站点
DISGUISE_PANEL = g("disguise_panel", "proxy:https://soft.xiaoz.org")
DISGUISE_NAIVE = g("disguise_naive", "proxy:https://soft.xiaoz.org")
DISGUISE_NAIVE2 = g("disguise_naive2", DISGUISE_NAIVE)

# 证书来源：cert_mode="manual" 且两路径齐全 -> 用绝对路径；否则回退 cert_dir/fullchain.pem+privkey.pem
# （与 Go 端 certPaths() 语义保持一致，全项目统一）
if g("cert_mode", "acme") == "manual" and g("cert_fullchain") and g("cert_privkey"):
    FULLCHAIN = g("cert_fullchain")
    PRIVKEY = g("cert_privkey")
else:
    FULLCHAIN = f"{CERTDIR}/fullchain.pem"
    PRIVKEY = f"{CERTDIR}/privkey.pem"

# 服务开关（面板内按需安装；无字段时默认 true 兼容旧部署）
def is_on(k):
    return str(g(k, "true")).lower() == "true"
SVC_SS = is_on("svc_ss_enabled")
SVC_ANYTLS = is_on("svc_anytls_enabled")
SVC_NAIVE = is_on("svc_naive_enabled")
# caddy_enable：是否部署 :443 伪装站 + :80 跳转。
#   true（默认，兼容旧部署）：caddy 监听 80/443，提供域名直访伪装
#   false（--no-caddy 模式，v1.5.6+）：跳过 80/443 站点块，让现有 nginx 等 web 服务器接管；
#             naive/naive2 站点仍生成（只听各自的 naive 端口，不碰 80/443）
CADDY_ENABLE = is_on("caddy_enable")

# ---- 读取密钥 ----
secrets = {}
if os.path.exists(SECRETS):
    with open(SECRETS) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            secrets[k.strip()] = v.strip().strip('"')

def sec(k):
    v = secrets.get(k, "")
    if not v:
        print(f"ansgo-genconf: 缺少 {k}（检查 {SECRETS}）", file=sys.stderr)
        sys.exit(2)
    return v

SS_KEY = sec("SS_KEY")
ANYTLS_PASS = sec("ANYTLS_PASS")
ANYTLS_UUID = sec("ANYTLS_UUID")
NAIVE_USER = sec("NAIVE_USER")
NAIVE_PASS = sec("NAIVE_PASS")

# 第2组密钥（启用时必需）
ANYTLS2_PASS = secrets.get("ANYTLS2_PASS", "")
ANYTLS2_UUID = secrets.get("ANYTLS2_UUID", "")
NAIVE2_USER = secrets.get("NAIVE2_USER", "")
NAIVE2_PASS = secrets.get("NAIVE2_PASS", "")
if GROUP2_ENABLED:
    for k in ("ANYTLS2_PASS", "ANYTLS2_UUID", "NAIVE2_USER", "NAIVE2_PASS"):
        if not secrets.get(k):
            print(f"ansgo-genconf: 第2组启用但缺少 {k}（执行 ansgo-admin regen2 生成）", file=sys.stderr)
            sys.exit(2)

# ===================== 生成 sing-box config =====================
def gen_singbox():
    inbounds = []
    # SS inbound（按开关）
    if SVC_SS:
        inbounds.append({
            "type": "shadowsocks", "tag": "ss-in",
            "listen": "::", "listen_port": SS_PORT,
            "method": SS_METHOD, "password": SS_KEY,
        })
    # AnyTLS inbound（按开关）
    if SVC_ANYTLS:
        inbounds.append({
            "type": "anytls", "tag": "anytls-in",
            "listen": "::", "listen_port": ANYTLS_PORT,
            "users": [{"name": ANYTLS_UUID, "password": ANYTLS_PASS}],
            "tls": {
                "enabled": True, "server_name": DOMAIN,
                "certificate_path": FULLCHAIN,
                "key_path": PRIVKEY,
            },
        })

    # 第2组 anytls-2 inbound（需第2组启用）
    if GROUP2_ENABLED and ANYTLS2_PORT:
        inbounds.append({
            "type": "anytls", "tag": "anytls-in2",
            "listen": "::", "listen_port": ANYTLS2_PORT,
            "users": [{"name": ANYTLS2_UUID, "password": ANYTLS2_PASS}],
            "tls": {
                "enabled": True, "server_name": DOMAIN,
                "certificate_path": FULLCHAIN,
                "key_path": PRIVKEY,
            },
        })

    outbounds = [{"type": "direct", "tag": "direct"}]

    # 落地 SS outbound（第2组走它）
    rules = []
    if LANDING_ENABLED and LANDING_HOST and LANDING_PORT and LANDING_PASS:
        outbounds.append({
            "type": "shadowsocks", "tag": "ss-out",
            "server": LANDING_HOST, "server_port": LANDING_PORT,
            "method": LANDING_METHOD, "password": LANDING_PASS,
        })
        # 第2组流量路由到 ss-out
        g2_inbounds = []
        if GROUP2_ENABLED and ANYTLS2_PORT:
            g2_inbounds.append("anytls-in2")
        if GROUP2_ENABLED and NAIVE2_PORT:
            g2_inbounds.append("naive-in2")
        if g2_inbounds:
            rules.append({
                "inbound": g2_inbounds,
                "action": "route", "outbound": "ss-out",
            })

    config = {
        "log": {"level": "warn", "timestamp": True},
        "inbounds": inbounds,
        "outbounds": outbounds,
    }
    if rules:
        config["route"] = {"rules": rules}

    # 无任何 inbound 时写一个占位配置（避免 sing-box 启动失败），
    # 但调用方应判断是否需要启动 sing-box
    os.makedirs("/etc/sing-box", exist_ok=True)
    if not inbounds:
        with open("/etc/sing-box/config.json", "w") as f:
            json.dump({"log": {"level": "warn"}, "inbounds": [], "outbounds": outbounds}, f, indent=2)
        print("已生成 /etc/sing-box/config.json (无启用 inbound，占位；sing-box 可不启动)")
        return

    with open("/etc/sing-box/config.json", "w") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)
    note = f"ss={SS_PORT}, anytls={ANYTLS_PORT}"
    if GROUP2_ENABLED:
        note += f", anytls2={ANYTLS2_PORT}"
        if LANDING_ENABLED:
            note += f"->ss-landing({LANDING_HOST}:{LANDING_PORT})"
    print(f"已生成 /etc/sing-box/config.json ({note}, sni={DOMAIN})")

# ===================== 生成 Caddyfile =====================
def disguise_block(val):
    """返回 caddy site block 内的伪装指令（缩进 2 空格的文本）"""
    if val.startswith("proxy:"):
        up = val[len("proxy:"):]
        import re
        m = re.match(r'^https?://([^/:]+)', up)
        host = m.group(1) if m else ""
        return f"  reverse_proxy {up} {{\n    header_up Host {host}\n  }}\n"
    else:  # page / file / file_server / 其它
        return "  file_server {\n    root /var/www/html\n  }\n"

def gen_caddy():
    blocks = []
    # global block：caddy_enable=false 时加 auto_https off
    #   （v1.5.8 修复：caddy 默认 auto_https on 会隐式监听 :80 做 ACME 挑战，
    #    --no-caddy 模式下 nginx 占着 80 → bind 失败；关掉 auto_https 避免冲突）
    if CADDY_ENABLE:
        blocks.append("{\n  order forward_proxy before reverse_proxy\n  order forward_proxy before file_server\n  admin off\n  log {\n    level error\n  }\n}\n")
    else:
        blocks.append("{\n  order forward_proxy before reverse_proxy\n  order forward_proxy before file_server\n  admin off\n  auto_https off\n  log {\n    level error\n  }\n}\n")

    # :443 纯反代伪装站（caddy_enable=true 时生成；--no-caddy 模式跳过让 nginx 接管）
    if CADDY_ENABLE:
        blocks.append(f"# :443 纯反代伪装站（浏览器直访命中，不提供代理）\n:443 {{\n  tls {FULLCHAIN} {PRIVKEY}\n  encode zstd gzip\n{disguise_block(DISGUISE_PANEL)}}}\n")

    # :naive_port NaiveProxy + 伪装（按开关；caddy_enable 无关——naive 站点独立于 80/443）
    if SVC_NAIVE:
        blocks.append(f"# :{NAIVE_PORT} NaiveProxy（forward_proxy 认证走代理，未认证走伪装）\n:{NAIVE_PORT} {{\n  tls {FULLCHAIN} {PRIVKEY}\n  encode zstd gzip\n  forward_proxy {{\n    basic_auth {NAIVE_USER} {NAIVE_PASS}\n    hide_ip\n    hide_via\n    probe_resistance\n  }}\n{disguise_block(DISGUISE_NAIVE)}}}\n")

    # 第2组 naive-2（caddy 另起一个 site）
    if GROUP2_ENABLED and NAIVE2_PORT:
        blocks.append(f"# :{NAIVE2_PORT} NaiveProxy 第2组（走 ss 落地）\n:{NAIVE2_PORT} {{\n  tls {FULLCHAIN} {PRIVKEY}\n  encode zstd gzip\n  forward_proxy {{\n    basic_auth {NAIVE2_USER} {NAIVE2_PASS}\n    hide_ip\n    hide_via\n    probe_resistance\n  }}\n{disguise_block(DISGUISE_NAIVE2)}}}\n")

    # :80 重定向（caddy_enable=true 时生成；--no-caddy 模式跳过）
    if CADDY_ENABLE:
        blocks.append(f":80 {{\n  redir https://{DOMAIN}{{uri}} permanent\n}}\n")

    os.makedirs("/etc/caddy", exist_ok=True)
    with open("/etc/caddy/Caddyfile", "w") as f:
        f.write("\n".join(blocks))
    note = f":443 纯伪装={DISGUISE_PANEL}" if CADDY_ENABLE else "caddy_enable=false（跳过 80/443，nginx 等接管）"
    if SVC_NAIVE:
        note += f", :{NAIVE_PORT} naive伪装={DISGUISE_NAIVE}"
    if GROUP2_ENABLED and NAIVE2_PORT:
        note += f", :{NAIVE2_PORT} naive2伪装={DISGUISE_NAIVE2}"
    suffix = ", :80->https 跳转" if CADDY_ENABLE else ""
    print(f"已生成 /etc/caddy/Caddyfile ({note}{suffix})")

# ===================== 校验 =====================
def do_validate():
    import subprocess
    print("=== sing-box check ===")
    r = subprocess.run(["/usr/local/bin/sing-box", "check", "-c", "/etc/sing-box/config.json"])
    if r.returncode == 0:
        print("sing-box config OK")
    print("=== caddy validate ===")
    subprocess.run(["/usr/local/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"])

if mode in ("sing-box", "all"):
    gen_singbox()
if mode in ("caddy", "all"):
    gen_caddy()
if mode == "validate":
    do_validate()
PYEOF
