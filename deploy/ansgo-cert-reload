#!/bin/sh
# =============================================================================
# ansgo-cert-reload —— 证书续期/替换后按需重载三服务
#
# 设计：重载「配置文件存在」的服务（不再 grep 固定证书路径）。
#   - acme.sh 模式：由 acme.sh --install-cert 的 --reloadcmd 自动调用
#   - 手动证书模式：由面板「重新加载证书」按钮或 SSH 手动调用
#   - 两种模式下证书都确已变更，文件存在即可 reload，无需校验路径内容
#
# 注：caddy 因 Caddyfile 设了 admin off，reload 无法通信，直接 restart
#     （续期闪断 1-2s 可接受）；sing-box 同样用 restart。
# =============================================================================
set -u

# caddy：因 admin off 用 restart
if [ -f /etc/caddy/Caddyfile ]; then
  systemctl restart caddy 2>/dev/null || true
fi

# sing-box：restart（含 ss + anytls）
if [ -f /etc/sing-box/config.json ]; then
  systemctl restart sing-box 2>/dev/null || true
fi

# ansgo-panel：仅在已安装时重启
if [ -f /etc/systemd/system/ansgo-panel.service ]; then
  systemctl restart ansgo-panel 2>/dev/null || true
fi

exit 0
